# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Legacy fallback for older Supabase projects/adapters; omit when publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* or client bundles.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Used by migrations, controlled server jobs, and local tooling.
DATABASE_URL=postgresql://postgres:replace-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres:replace-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Application and callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Private object stores created by the security migration.
ATQ_RECORDS_BUCKET=atq-records
ATQ_EVIDENCE_BUCKET=atq-evidence

# Domain controls. Synthetic mode must remain true until production gates pass.
ATQ_SYNTHETIC_DATA_ONLY=true
ATQ_PROGRAM_RESOLVER_VERSION=atq-program-resolver/1.0.0

# Worker identity and delivery settings. Generate a stable UUID per deployment.
ATQ_WORKER_ID=00000000-0000-4000-8000-000000000000
ATQ_OUTBOX_BATCH_SIZE=25

# Optional outbound adapters; leave unset to disable delivery.
EMAIL_PROVIDER_API_KEY=
INTEGRATION_WEBHOOK_SIGNING_SECRET=
